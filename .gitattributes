# Files whose on-disk byte format is enforced by a test must NOT be subject
# to Git's autocrlf line-ending translation on Windows checkouts. Without
# eol=lf, the format-pinning / drift-guard tests would fail on Windows where
# Git converts LF -> CRLF on checkout (core.autocrlf=true default).
src/hermia/test-datasets/agentic-tasks.json text eol=lf
docs/corpus-catalog.md text eol=lf
